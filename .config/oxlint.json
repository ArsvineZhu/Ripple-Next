{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-explicit-any": "error",
    "react-hooks/rules-of-hooks": "error",
    "react/set-state-in-effect": "off"
  },
  "ignorePatterns": [
    "**/.vite/**",
    "**/out/**",
    "**/node_modules/**",
    "**/components/liquidGlass/vendor/**"
  ],
  "overrides": [
    {
      "files": ["**/src/renderer/**/*.{ts,tsx}"],
      "env": {
        "browser": true
      },
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["node:*", "electron", "x11", "**/main/**", "**/preload/**"]
          }
        ],
        "no-restricted-globals": ["error", "process", "require", "Buffer", "__dirname"]
      }
    },
    {
      "files": ["**/src/shared/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["electron", "node:*", "**/main/**", "**/preload/**", "**/renderer/**"]
          }
        ]
      }
    }
  ]
}
