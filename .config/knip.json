{
  "$schema": "https://unpkg.com/knip/schema.json",
  "entry": [
    "src/main/index.ts",
    "src/preload/index.ts",
    ".config/forge.config.ts",
    ".config/vite.*.config.mts",
    "tests/**/*.test.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    ".config/**/*.ts",
    ".config/**/*.mts"
  ],
  "ignore": ["src/renderer/components/liquidGlass/vendor/**"],
  "ignoreBinaries": ["gio"]
}
