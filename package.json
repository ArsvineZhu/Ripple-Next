{
  "name": "ripple-next",
  "productName": "Ripple Next",
  "version": "4.1.0-beta.1",
  "description": "A Dynamic Island for All Platforms",
  "homepage": "https://github.com/ArsvineZhu/Ripple-Next",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArsvineZhu/Ripple-Next.git"
  },
  "bugs": {
    "url": "https://github.com/ArsvineZhu/Ripple-Next/issues"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "tsx scripts/start.ts",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "oxlint --config .config/oxlint.json --deny-warnings",
    "typecheck": "tsc -p .config/tsconfig.main.json && tsc -p .config/tsconfig.preload.json && tsc -p .config/tsconfig.renderer.json && tsc -p .config/tsconfig.tools.json",
    "format": "prettier --config .config/prettier.json --ignore-path .config/prettierignore --write \"src/**/*.{ts,tsx,css,md}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\" \"*.md\" \"package.json\" \"pnpm-workspace.yaml\" \"tsconfig.json\" \".github/**/*.{yml,yaml}\" \".config/**/*.{json,ts,mts,md}\"",
    "format:check": "prettier --config .config/prettier.json --ignore-path .config/prettierignore --check \"src/**/*.{ts,tsx,css,md}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\" \"*.md\" \"package.json\" \"pnpm-workspace.yaml\" \"tsconfig.json\" \".github/**/*.{yml,yaml}\" \".config/**/*.{json,ts,mts,md}\"",
    "deadcode": "knip --config .config/knip.json",
    "duplicates": "jscpd --config .config/duplication.json src",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run deadcode && pnpm run duplicates",
    "test": "vitest run --config .config/vitest.config.mts",
    "build:native": "node scripts/build-native.mjs"
  },
  "keywords": [
    "dynamic island",
    "electron",
    "cross-platform",
    "macos",
    "windows",
    "linux"
  ],
  "author": {
    "name": "Arsvine Zhu",
    "email": "arsvinezhu@gmail.com"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.9.1",
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.79",
    "@ai-sdk/openai": "4.0.92",
    "@ai-sdk/openai-compatible": "3.0.62",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/core": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-wix": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@xstate/react": "6.1.0",
    "ai": "7.0.127",
    "cmdk": "1.1.1",
    "dbus-native": "0.16.1",
    "electron": "44.5.1",
    "happy-dom": "20.14.5",
    "i18next": "26.4.2",
    "jscpd": "5.4.0",
    "knip": "6.39.0",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-markdown": "10.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "x11": "4.3.0",
    "xstate": "5.33.2",
    "zod": "4.6.5"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-log": "5.4.4"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=12"
  },
  "config": {
    "forge": "./.config/forge.config.ts"
  }
}
